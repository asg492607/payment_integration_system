<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PayForge Background SMS Forwarder"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enterprise ID:"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editEnterpriseId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. ent_123456"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Webhook Secret:"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editSecret"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Your dashboard secret"
        android:inputType="textPassword"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save &amp; Enable Forwarding"
        android:layout_marginTop="16dp"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Not Configured"
        android:textAlignment="center"
        android:textColor="#FF0000"
        android:layout_marginTop="24dp"
        android:textStyle="bold"/>

</LinearLayout>
